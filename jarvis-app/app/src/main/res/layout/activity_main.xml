<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🤖 JARVIS" android:textSize="30sp" android:textStyle="bold"
        android:textColor="@color/accent"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Aapka personal voice assistant — phone ka kuch bhi kaam, bol ke karwao."
        android:textSize="13sp" android:textColor="@color/mute" android:layout_marginBottom="16dp"/>

    <TextView android:id="@+id/permStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:padding="14dp" android:textSize="13sp"
        android:textColor="@color/ink" android:lineSpacingExtra="4dp"
        android:text="Checking permissions…"/>

    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="▶  Assistant START karo" android:textStyle="bold"/>
    <Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="■  Stop assistant"/>
    <Button android:id="@+id/btnOverlay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="⚠  Overlay permission do"/>
    <Button android:id="@+id/btnArena" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="🌐  Arena.ai kholo (ek baar login karo)"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Voice language (Hinglish dono me chalta hai)"
        android:textSize="12sp" android:textColor="@color/mute" android:layout_marginTop="18dp"/>
    <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
      <RadioButton android:id="@+id/langHi" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="हिंदी (hi-IN)" android:textColor="@color/ink" android:paddingEnd="16dp"/>
      <RadioButton android:id="@+id/langEn" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="English (en-IN)" android:textColor="@color/ink"/>
    </RadioGroup>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="14dp" android:gravity="center_vertical">
      <TextView android:id="@+id/pinView" android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:background="@color/card" android:padding="12dp"
          android:textSize="12sp" android:textColor="@color/ink"
          android:text="📌 Pinned chat: koi nahi"/>
      <Button android:id="@+id/btnUnpin" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginStart="8dp" android:text="✕"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="📋 TASK QUEUE (bol ke banega — 'task banao: pehle X, phir Y')"
        android:textSize="12sp" android:textColor="@color/mute" android:layout_marginTop="18dp"/>
    <TextView android:id="@+id/queueView" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:padding="12dp" android:textSize="13sp"
        android:textColor="@color/ink" android:minLines="1"
        android:text="Khaali — koi kaam pending nahi"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:textSize="13sp" android:textColor="@color/ink"
        android:lineSpacingExtra="5dp"
        android:background="@color/card" android:padding="14dp"
        android:text="🎤 BOLO (bubble dabao, phir bolo):\n\n• Chrome / WhatsApp / YouTube kholo\n• YouTube pe lofi beats chalao\n• Google pe CBSE 10 result search karo\n• Mummy ko call karo\n• Alarm lagao 6 baje\n• Timer lagao 5 minute\n• Torch on / off karo\n• Volume badhao / full karo\n• Battery kitni hai? Time kya hua?\n• Arena.ai kholo · naya chat kholo · latest chat kholo\n• Arena pe likho: chapter 1 ka summary do\n• Task banao — pehle arena pe maths poochho, phir YouTube pe physics chalao, phir papa ko call karo\n• Next / Stop / Status\n\n💬 Arena khula ho to seedha bolo — likh ke dikhayenge, haan bologe to send."/>
  </LinearLayout>
</ScrollView>
