<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true" android:scrollbars="none">
  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">

    <!-- hero -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
        <View android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/logo_grad"/>
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:layout_gravity="center" android:src="@drawable/ic_mic"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Jarvis" android:textSize="30sp" android:textStyle="bold"
            android:textColor="@color/ink" android:letterSpacing="-0.02"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Personal voice assistant" android:textSize="13sp" android:textColor="@color/mute"/>
      </LinearLayout>
    </LinearLayout>

    <!-- setup -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SETUP" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/accent" android:letterSpacing="0.12"
        android:layout_marginTop="28dp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card" android:padding="18dp">
      <TextView android:id="@+id/permMic" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Microphone" android:textSize="15sp" android:textColor="@color/ink" android:paddingVertical="6dp"/>
      <TextView android:id="@+id/permContacts" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Contacts — for calls" android:textSize="15sp" android:textColor="@color/ink" android:paddingVertical="6dp"/>
      <TextView android:id="@+id/permOverlay" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Display over other apps" android:textSize="15sp" android:textColor="@color/ink" android:paddingVertical="6dp"/>
    </LinearLayout>

    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="14dp" android:text="Start Assistant" android:textStyle="bold"
        android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/pill_dark"
        android:stateListAnimator="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
      <Button android:id="@+id/btnArena" android:layout_width="0dp" android:layout_height="48dp"
          android:layout_weight="1" android:text="Open Arena.ai" android:textSize="14sp"
          android:textColor="@color/ink" android:background="@drawable/pill_light"
          android:stateListAnimator="@null" android:layout_marginEnd="5dp"/>
      <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="48dp"
          android:layout_weight="1" android:text="Stop" android:textSize="14sp"
          android:textColor="@color/mute" android:background="@drawable/pill_light"
          android:stateListAnimator="@null" android:layout_marginStart="5dp"/>
    </LinearLayout>

    <!-- language -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="LANGUAGE" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/accent" android:letterSpacing="0.12"
        android:layout_marginTop="28dp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:background="@drawable/pill_light" android:padding="4dp">
      <Button android:id="@+id/langEn" android:layout_width="0dp" android:layout_height="match_parent"
          android:layout_weight="1" android:text="English" android:textSize="14sp" android:textStyle="bold"
          android:textColor="@color/ink" android:background="@drawable/seg_on" android:stateListAnimator="@null"/>
      <Button android:id="@+id/langHi" android:layout_width="0dp" android:layout_height="match_parent"
          android:layout_weight="1" android:text="हिन्दी" android:textSize="14sp" android:textStyle="bold"
          android:textColor="@color/mute" android:background="@drawable/seg_off" android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- queue -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TASK QUEUE" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/accent" android:letterSpacing="0.12"
        android:layout_marginTop="28dp" android:layout_marginBottom="8dp"/>
    <TextView android:id="@+id/queueView" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/card" android:padding="18dp" android:textSize="14sp"
        android:textColor="@color/mute" android:lineSpacingExtra="6dp"
        android:text="Empty — no pending tasks.\nSay: task — first check maths on Arena, then play physics on YouTube, then call Papa."/>

    <!-- examples -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="WHAT YOU CAN SAY" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/accent" android:letterSpacing="0.12"
        android:layout_marginTop="28dp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card" android:padding="18dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="APPS" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/mute" android:letterSpacing="0.1"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="• Open Chrome / WhatsApp / YouTube\n• Play lofi beats on YouTube\n• Search CBSE result on Google"
          android:textSize="14sp" android:textColor="@color/ink" android:lineSpacingExtra="6dp" android:layout_marginTop="6dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="PHONE" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/mute" android:letterSpacing="0.1" android:layout_marginTop="14dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="• Call Papa\n• Set an alarm for 6 AM\n• Set a timer for 5 minutes\n• Torch on / off\n• Volume up / full\n• What is the battery level?"
          android:textSize="14sp" android:textColor="@color/ink" android:lineSpacingExtra="6dp" android:layout_marginTop="6dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="ARENA.AI" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/mute" android:letterSpacing="0.1" android:layout_marginTop="14dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="• Open Arena\n• New chat\n• Ask Arena: explain chapter 1\nEvery task always starts a fresh, empty chat."
          android:textSize="14sp" android:textColor="@color/ink" android:lineSpacingExtra="6dp" android:layout_marginTop="6dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="CHAINED TASKS" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/mute" android:letterSpacing="0.1" android:layout_marginTop="14dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="• Task — first ask Arena for a maths summary, then play physics on YouTube, then call Papa\nThe next task starts automatically when one finishes.\n• Next  • Stop  • Status"
          android:textSize="14sp" android:textColor="@color/ink" android:lineSpacingExtra="6dp" android:layout_marginTop="6dp"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Jarvis 1.1 — built by Mohd Haziq" android:textSize="12sp"
        android:textColor="@color/mute" android:gravity="center" android:layout_marginTop="28dp"/>
  </LinearLayout>
</ScrollView>
